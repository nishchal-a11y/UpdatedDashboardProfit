  <diagram id="cost-allocation" name="Cost Allocation">
    <mxGraphModel dx="1200" dy="1700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="payroll" value="Monthly Payroll Workbook&lt;br&gt;Employee Number / Employee Name&lt;br&gt;Payroll Month / Total (INR)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F8FA;strokeColor=#D0D7DE;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="35" y="40" width="300" height="100" as="geometry" /></mxCell>
        <mxCell id="master" value="Employee Master&lt;br&gt;Employee Number / Full Name&lt;br&gt;Timesheet identity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F8FA;strokeColor=#D0D7DE;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="450" y="40" width="300" height="100" as="geometry" /></mxCell>
        <mxCell id="revisions" value="Approved Salary Revisions&lt;br&gt;Previous / Revised Regular Salary (INR)&lt;br&gt;Effective From" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#F58217;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="865" y="40" width="300" height="100" as="geometry" /></mxCell>
        <mxCell id="identity" value="Match Payroll to Timesheet Person&lt;br&gt;1. Employee Number&lt;br&gt;2. Unique normalized name fallback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F58217;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="370" y="200" width="460" height="105" as="geometry" /></mxCell>
        <mxCell id="revisioncheck" value="Does payroll Total match the previous regular salary / 12 within 1% (minimum INR 2), and does the revision change the monthly amount?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#F58217;fontSize=14;spacing=12;" vertex="1" parent="1"><mxGeometry x="425" y="360" width="350" height="150" as="geometry" /></mxCell>
        <mxCell id="applyrevision" value="Yes: Treat Total as stale&lt;br&gt;Use approved revised salary from Effective From&lt;br&gt;Weight old / revised rates by calendar days" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0E6;strokeColor=#F58217;fontSize=14;spacing=12;" vertex="1" parent="1"><mxGeometry x="35" y="575" width="400" height="115" as="geometry" /></mxCell>
        <mxCell id="keepactual" value="No: Keep payroll Total as actual&lt;br&gt;Covers months already updated and catch-up payments&lt;br&gt;Prevents double-counting a raise" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F8FA;strokeColor=#D0D7DE;fontSize=14;spacing=12;" vertex="1" parent="1"><mxGeometry x="765" y="575" width="400" height="115" as="geometry" /></mxCell>
        <mxCell id="monthlycost" value="Calculated Monthly Cost (INR)&lt;br&gt;Revision-adjusted only for stale prior-salary totals&lt;br&gt;Otherwise monthly payroll Total" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F58217;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="370" y="745" width="460" height="100" as="geometry" /></mxCell>
        <mxCell id="monthlyaudit" value="Monthly Payroll Cost Audit&lt;br&gt;Raw Total / calculated month cost&lt;br&gt;Effective date / apply-versus-retain decision" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F8FA;strokeColor=#D0D7DE;fontSize=13;spacing=12;" vertex="1" parent="1"><mxGeometry x="865" y="745" width="300" height="100" as="geometry" /></mxCell>
        <mxCell id="windowdays" value="Selected Window Cost&lt;br&gt;Sum daily payroll / revised salary cost for overlapping dates&lt;br&gt;Payroll coverage is tracked by calendar day" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D0D7DE;fontSize=14;spacing=12;" vertex="1" parent="1"><mxGeometry x="370" y="900" width="460" height="100" as="geometry" /></mxCell>
        <mxCell id="coverage" value="Is the entire selected date window covered by payroll?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#F58217;fontSize=14;spacing=12;" vertex="1" parent="1"><mxGeometry x="410" y="1050" width="380" height="120" as="geometry" /></mxCell>
        <mxCell id="locked" value="No: Payroll cost, profit and margin remain locked&lt;br&gt;A manual AED / hour override can still be applied" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F0;strokeColor=#E5484D;fontSize=14;spacing=12;" vertex="1" parent="1"><mxGeometry x="825" y="1060" width="340" height="100" as="geometry" /></mxCell>
        <mxCell id="fx" value="Convert INR to AED&lt;br&gt;AED = INR × 0.042" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D0D7DE;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="370" y="1230" width="460" height="85" as="geometry" /></mxCell>
        <mxCell id="hourly" value="Employee Cost Rate&lt;br&gt;Window cost (AED) / employee logged hours" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F58217;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="370" y="1360" width="460" height="85" as="geometry" /></mxCell>
        <mxCell id="manual" value="Manual Override&lt;br&gt;Fixed AED / hour for all employees&lt;br&gt;Overrides CSV until cleared" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#3B82F6;fontSize=14;spacing=12;" vertex="1" parent="1"><mxGeometry x="865" y="1350" width="300" height="100" as="geometry" /></mxCell>
        <mxCell id="rowcost" value="Cost per Timesheet Row&lt;br&gt;Row hours × active employee rate&lt;br&gt;Includes actual and allocated internal hours" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F58217;fontSize=14;spacing=12;" vertex="1" parent="1"><mxGeometry x="370" y="1490" width="460" height="100" as="geometry" /></mxCell>
        <mxCell id="output" value="Dashboard Outputs&lt;br&gt;People · Client · Project · Overview&lt;br&gt;Profit / margin use recognized revenue minus cost" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7EF;strokeColor=#189653;fontSize=14;spacing=12;" vertex="1" parent="1"><mxGeometry x="370" y="1640" width="460" height="90" as="geometry" /></mxCell>
